{
  "name": "cainiao-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create cainiao-db",
    "migrate:local": "wrangler d1 execute cainiao-db --local --file schema.sql",
    "migrate:remote": "wrangler d1 execute cainiao-db --remote --file schema.sql",
    "seed:local": "node seed.mjs local",
    "seed:remote": "node seed.mjs remote"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
